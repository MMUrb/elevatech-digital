# Copy this file to ".env" and fill in your values, then restart `npm run dev`.
# Anything prefixed with VITE_ is exposed to the browser at build time.

# Free access key from https://web3forms.com (powers the contact form)
VITE_WEB3FORMS_KEY=

# Note: each service's Calendly link is set per-service via the data-calendly
# attribute on its "Book" button in index.html (public scheduling links).
